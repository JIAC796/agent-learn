# 复制本文件为 .env，填入自己的 Key
# .env 已被 .gitignore 忽略，不会被提交
#
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# DeepSeek（对话模型）
DEEPSEEK_API_KEY=sk-替换成你自己的Key

# 硅基流动（bge-m3 嵌入 + bge-reranker 重排，免费额度足够学习用）
SILICONFLOW_API_KEY=sk-替换成你自己的Key

# 可选：指定向量库目录（不设则用代码里的默认值）
# KB_PATH=./kb_chroma_v2
